# Build stage
FROM rust:1.82 as builder
WORKDIR /termdex

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libpq-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency files first for better caching
COPY Cargo.toml Cargo.lock ./

# Copy source files
COPY src/ src/
COPY sprites/ sprites/

# Build the application
RUN cargo build --release --bin termdex

# Runtime stage
FROM debian:bookworm-slim
WORKDIR /termdex

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    libpq5 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy the binary from builder
COPY --from=builder /termdex/target/release/termdex /usr/local/bin/termdex
COPY --from=builder /termdex/sprites /termdex/sprites

# Make binary executable
RUN chmod +x /usr/local/bin/termdex

CMD ["/usr/local/bin/termdex"]
